#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct Params {
    ivec2 surface_size;
    ivec2 offset;

    uint paint_type;
    uint op;
    uint n_stops;
    uint has_fill;

    uint extend;
    uint num_clip_paths;
    uint num_clip_rects;
    uint opaque;

    float opacity;
    float pad1;
    float pad2;
    float pad3;

    vec4 solid;
    vec4 p1;
    vec4 p2;
    mat4 pattern_matrix;
    vec4 stops[16];
    float stop_offsets[16];
};

layout(std430, binding = 0) readonly buffer EdgeBuffer {
    vec4 edges[];
};

layout(std430, binding = 1) readonly buffer PathBuffer {
    uvec4 paths[];
};

layout(std430, binding = 2) readonly buffer ClipRectBuffer {
    vec4 clip_rects[];
};

layout(std430, binding = 3) readonly buffer ParamsBuffer {
    Params params;
};

layout(std430, binding = 4) buffer PixelBuffer {
    uint pixels[];
};

bool
point_in_path (vec2 p, uint first, uint count, uint rule)
{
    int winding = 0;
    int crossings = 0;

    for (uint i = 0; i < count; ++i) {
        vec4 e = edges[first + i];

        if (e.y <= p.y && p.y < e.w) {
            float x = e.x + (p.y - e.y) * (e.z - e.x) / (e.w - e.y);
            if (x > p.x) {
                winding += 1;
                crossings += 1;
            }
        } else if (e.w <= p.y && p.y < e.y) {
            float x = e.x + (p.y - e.y) * (e.z - e.x) / (e.w - e.y);
            if (x > p.x) {
                winding -= 1;
                crossings += 1;
            }
        }
    }

    if (rule == 1u)
        return (crossings & 1) != 0;

    return winding != 0;
}

float
path_coverage (vec2 pixel, uint first, uint count, uint rule, uint axis_samples)
{
    int samples = int(axis_samples);
    if (samples <= 1)
        return point_in_path (pixel + vec2 (0.5), first, count, rule) ? 1.0 : 0.0;

    float total = float (samples * samples);
    float covered = 0.0;

    for (int y = 0; y < samples; ++y) {
        for (int x = 0; x < samples; ++x) {
            vec2 location = pixel + (vec2 (x, y) + vec2 (0.5)) / float (samples);
            if (point_in_path (location, first, count, rule))
                covered += 1.0;
        }
    }

    return covered / total;
}

vec4
sample_stops (float t)
{
    if (params.n_stops == 0u)
        return vec4 (0.0);

    if (t <= params.stop_offsets[0])
        return params.stops[0];

    for (uint i = 1; i < params.n_stops; ++i) {
        if (t <= params.stop_offsets[i]) {
            float span = params.stop_offsets[i] - params.stop_offsets[i - 1];
            if (span <= 0.0)
                return params.stops[i];

            float u = (t - params.stop_offsets[i - 1]) / span;
            return mix (params.stops[i - 1], params.stops[i], u);
        }
    }

    return params.stops[params.n_stops - 1u];
}

vec4
extend_gradient (float t)
{
    if (params.extend == 0u) {
        if (t < 0.0 || t > 1.0)
            return vec4 (0.0);
    } else if (params.extend == 1u) {
        t = fract (t);
    } else if (params.extend == 2u) {
        t = 1.0 - abs (mod (t, 2.0) - 1.0);
    } else {
        t = clamp (t, 0.0, 1.0);
    }

    return sample_stops (t);
}

float
radial_parameter (vec2 p)
{
    vec2 c1 = params.p1.xy;
    float r1 = params.p1.z;
    vec2 c2 = params.p2.xy;
    float r2 = params.p2.z;

    vec2 d = c2 - c1;
    float dr = r2 - r1;
    vec2 pc = p - c1;

    float a = dot (d, d) - dr * dr;
    float b = 2.0 * (dot (pc, d) - r1 * dr);
    float c = dot (pc, pc) - r1 * r1;

    if (abs (a) < 1e-9) {
        if (abs (b) < 1e-9)
            return -1.0;
        return -c / b;
    }

    float disc = b * b - 4.0 * a * c;
    if (disc < 0.0)
        return -1.0;

    float root = sqrt (disc);
    float t0 = (-b - root) / (2.0 * a);
    float t1 = (-b + root) / (2.0 * a);

    return a < 0.0 ? max (t0, t1) : min (t0, t1);
}

vec4
paint_color (vec2 p)
{
    if (params.paint_type == 0u)
        return params.solid;

    vec2 q = (params.pattern_matrix * vec4 (p, 0.0, 1.0)).xy;
    float t;

    if (params.paint_type == 1u) {
        vec2 d = params.p2.xy - params.p1.xy;
        float len2 = dot (d, d);
        if (len2 < 1e-9)
            return sample_stops (0.0);
        t = dot (q - params.p1.xy, d) / len2;
    } else {
        t = radial_parameter (q);
        if (t < 0.0) {
            if (distance (q, params.p1.xy) <= params.p1.z)
                t = 0.0;
            else
                return vec4 (0.0);
        }
    }

    return extend_gradient (t);
}

vec4
blend (vec4 src, vec4 dst, float coverage)
{
    int op = int (params.op);

    if (op == 0)
        return dst * (1.0 - coverage);
    if (op == 1)
        return src + dst * (1.0 - coverage);
    if (op == 2)
        return src + dst * (1.0 - src.a);
    if (op == 3)
        return src * dst.a;
    if (op == 4)
        return src * (1.0 - dst.a);
    if (op == 5)
        return src * dst.a + dst * (1.0 - src.a);
    if (op == 6)
        return dst;
    if (op == 7)
        return dst + src * (1.0 - dst.a);
    if (op == 8)
        return dst * src.a;
    if (op == 9)
        return dst * (1.0 - src.a);
    if (op == 10)
        return dst * src.a + src * (1.0 - dst.a);
    if (op == 11)
        return src * (1.0 - dst.a) + dst * (1.0 - src.a);
    if (op == 12)
        return min (src + dst, vec4 (1.0));

    return dst;
}

vec4
unpack_pixel (uint p)
{
    return vec4 (float ((p >> 16) & 0xffu),
                 float ((p >> 8) & 0xffu),
                 float (p & 0xffu),
                 float ((p >> 24) & 0xffu)) / 255.0;
}

uint
pack_pixel (vec4 c)
{
    c = clamp (c, vec4 (0.0), vec4 (1.0));
    uint r = uint (c.r * 255.0 + 0.5);
    uint g = uint (c.g * 255.0 + 0.5);
    uint b = uint (c.b * 255.0 + 0.5);
    uint a = uint (c.a * 255.0 + 0.5);
    return (a << 24) | (r << 16) | (g << 8) | b;
}

void
main ()
{
    ivec2 pixel = ivec2 (gl_GlobalInvocationID.xy) + params.offset;
    if (pixel.x < 0 || pixel.y < 0 ||
        pixel.x >= params.surface_size.x || pixel.y >= params.surface_size.y)
        return;

    vec2 p = vec2 (pixel);
    float coverage = 1.0;

    if (params.has_fill != 0u) {
        uvec4 path = paths[0];
        coverage = path_coverage (p, path.x, path.y, path.z, path.w);
        if (coverage <= 0.0)
            return;
    }

    uint clip_path_offset = params.has_fill != 0u ? 1u : 0u;
    for (uint i = 0; i < params.num_clip_paths; ++i) {
        uvec4 path = paths[clip_path_offset + i];
        float clip = path_coverage (p, path.x, path.y, path.z, path.w);
        coverage *= clip;
        if (coverage <= 0.0)
            return;
    }

    if (params.num_clip_rects != 0u) {
        vec2 center = p + vec2 (0.5);
        bool inside = false;
        for (uint i = 0; i < params.num_clip_rects; ++i) {
            vec4 r = clip_rects[i];
            if (center.x >= r.x && center.y >= r.y &&
                center.x < r.z && center.y < r.w) {
                inside = true;
                break;
            }
        }

        if (!inside)
            return;
    }

    uint index = uint (pixel.y) * uint (params.surface_size.x) + uint (pixel.x);
    vec4 dst = unpack_pixel (pixels[index]);
    if (params.opaque != 0u)
        dst.a = 1.0;
    vec4 src = paint_color (p) * coverage * params.opacity;
    vec4 result = blend (src, dst, coverage);
    if (params.opaque != 0u)
        result.a = 1.0;
    pixels[index] = pack_pixel (result);
}
